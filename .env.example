# Copy to .env.local for development, or set these in Vercel Project Settings
# > Environment Variables for production/preview.

# Meta (Facebook) Pixel ID from Meta Events Manager (business.facebook.com/events_manager).
# Leave unset and the pixel script simply won't load — no broken/empty calls.
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID from TikTok Ads Manager (ads.tiktok.com > Assets > Events).
# Leave unset and the pixel script simply won't load.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Upstash Redis (successor to the deprecated Vercel KV) for Partner Program
# referral click tracking. Add a Redis integration from the Vercel
# Marketplace (vercel.com/marketplace?category=storage&search=redis) and
# these get injected automatically. Leave unset and referral clicks just
# fall back to server console logs, same as before.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
