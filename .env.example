# Copy to .env.local for development, or set these in Vercel Project Settings
# > Environment Variables for production/preview.

# Meta (Facebook) Pixel ID from Meta Events Manager (business.facebook.com/events_manager).
# Leave unset and the pixel script simply won't load — no broken/empty calls.
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID from TikTok Ads Manager (ads.tiktok.com > Assets > Events).
# Leave unset and the pixel script simply won't load.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Upstash Redis (successor to the deprecated Vercel KV). Backs referral click
# tracking, captain codes, trade leads and the reorder queue. Add a Redis
# integration from the Vercel Marketplace
# (vercel.com/marketplace?category=storage&search=redis) and these get
# injected automatically.
#
# Without these, every feature still renders and is testable, but nothing
# persists: captain codes are minted and forgotten, trade enquiries fall back
# to a console.warn, and the reorder cron has no queue to read. This is the
# first thing to set up.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for Vercel CRON routes. Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>`. Enforced only in production.
CRON_SECRET=

# Shared password gating /internal (roadmap + HSA certification checklist).
# Anything under /internal redirects to /internal/login until this matches.
# Pick something you can say over the phone to a co-founder, not a generated
# secret — this gates one shared team page, not individual accounts.
#
# Leave unset and /internal fails closed (redirects home) rather than being
# left open by an unset variable.
INTERNAL_SITE_PASSWORD=

# WhatsApp Cloud API — powers the reorder nudge cron
# (/api/cron/reorder-nudges).
#
# Get both from developers.facebook.com > your app > WhatsApp > API Setup.
# Use a System User token, NOT the 24-hour temporary token shown on that page,
# or sends will start failing a day after you set this up.
#
# Leave unset and the cron runs in DRY RUN: it selects who is due and does all
# the scheduling, but sends nothing. Run it that way first and read the
# response counts — it's the cheapest way to catch a bad import before 15,000
# people get a message.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
